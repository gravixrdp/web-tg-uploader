# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_API_BASE=https://api.telegram.org

# Scraping & Target Configuration
CRAWL_TARGET_URL=https://example.com/sitemap.xml
CRAWL_MODE=auto
MAX_PAGES=10
PERIODIC_CRAWL_INTERVAL=0

# Rate Limiting, Retries & Pipeline
UPLOAD_COOLDOWN=20
MAX_RETRIES=5

# Storage & Persistence
DB_PATH=data/queue.db
TEMP_DOWNLOAD_DIR=temp_downloads

# Health Check Server (Optional for Railway deployment)
# HTTP_PORT=8080

# Caption Templating & Formatting
# Placeholders available: {title}, {size}, {duration}, {filename}, {resolution}, {width}, {height}, {id}, {url}, {date}, {time}, or custom tags
CAPTION_TEMPLATE=🎬 <b>{title}</b>\n\n📁 <b>Size:</b> {size}\n⏱ <b>Duration:</b> {duration}
TELEGRAM_PARSE_MODE=HTML
